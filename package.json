{
  "name": "reem",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c magenta,cyan \"node --watch server/index.js\" \"npm --prefix client run dev\"",
    "build": "npm --prefix client run build",
    "start": "NODE_ENV=production node server/index.js",
    "test": "node --test --test-force-exit --test-concurrency=1",
    "setup": "npm install && npm --prefix client install",
    "reset-password": "node scripts/reset-password.js",
    "make-master": "node scripts/make-master.js",
    "migrate-to-assignments": "node scripts/migrate-to-assignments.js",
    "consolidate-agents": "node scripts/consolidate-agents.js",
    "backfill-embeddings": "node scripts/backfill-embeddings.js",
    "backfill-companies": "node scripts/backfill-companies.js",
    "backfill-expiry": "node scripts/backfill-expiry.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@huggingface/transformers": "^4.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "archiver": "^7.0.1",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "imapflow": "^2.0.5",
    "mailparser": "^3.9.28",
    "mammoth": "^1.12.3",
    "multer": "^2.4.0",
    "mupdf": "^1.28.1",
    "nodemailer": "^10.0.10",
    "openai": "^7.18.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "unpdf": "^1.8.1",
    "web-ifc": "0.0.78",
    "web-push": "^3.6.7",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  },
  "allowScripts": {
    "onnxruntime-node@1.30.0": true,
    "protobufjs@7.6.6": true
  }
}
